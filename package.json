{
  "name": "bettertouchtool",
  "version": "1.0.0-alpha.7",
  "description": "Official, typed JavaScript/TypeScript client for BetterTouchTool's scripting API (webserver, unix socket, or in-process). AI generated & maintained by folivora.AI. Successor to the unmaintained `btt` package.",
  "license": "MIT",
  "author": "folivora.AI GmbH",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/browser.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js",
      "require": "./dist/catalog.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    }
  },
  "bin": {
    "btt": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "BTT_LIVE=1 vitest run test/live",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "generate": "node --import tsx scripts/generate-catalogs.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check": "npm run lint && npm run typecheck && npm test",
    "sync:btt": "node scripts/sync-to-btt.mjs",
    "postversion": "npm run build && npm run sync:btt && echo 'bundled copy synced into ../BetterTouchTool - commit it there with the next BTT version'"
  },
  "keywords": [
    "bettertouchtool",
    "btt",
    "macos",
    "automation",
    "touchbar",
    "streamdeck",
    "floating-menu",
    "shortcuts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/folivoraAI/bettertouchtool-js.git"
  },
  "homepage": "https://github.com/folivoraAI/bettertouchtool-js#readme",
  "bugs": "https://github.com/folivoraAI/bettertouchtool-js/issues",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
